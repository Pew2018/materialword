**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/android/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# ---------------------------------------------------------------------------
# MaterialWord specifics
# ---------------------------------------------------------------------------

# Local databases and personal study data must never be committed.
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
!/assets/dictionary/ecdict_core.db

# Backups produced while testing.
materialword-backup-*.json

# Signing material: never commit keys, passwords or Gradle signing config.
android/key.properties
*.jks
*.keystore
*.p12
*.p8
*.mobileprovision

# Raw ECDICT download used to regenerate the bundled dictionary.
ecdict.csv
stardict.7z

# Local tooling output.
dist/

# Local benchmark logs and scratch output.
work/

# Golden failure dumps (local runs and CI artifacts)
test/failures/

# gen_l10n untranslated report (regenerated by every build, always empty here)
l10n_untranslated.json
